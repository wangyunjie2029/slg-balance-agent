DEEPSEEK_API_KEY=sk-xxxx

# 可观测（可选）：不填则 Langfuse 不上报，本地开发仍可跑
LANGFUSE_PUBLIC_KEY=pk-lf-xxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxx
LANGFUSE_HOST=https://cloud.langfuse.com

# 接口鉴权（可选）：留空则不校验，仅适合本地开发；部署时务必设置
API_TOKEN=

# 以下均为可选，不填则用 backend/config.py 里的默认值
# SIM_N=500              每次对战模拟的局数
# DAMAGE_JITTER=0.35     伤害随机抖动幅度（改它必须重跑 gen_cases.py 重新取证）
# MAX_ROUNDS=10          Agent 工具调用轮数上限
# WINDOW_SIZE=12         上下文滑窗保留的消息条数
# TOOL_TIMEOUT=30        单次工具执行超时（秒）
# RATE_LIMIT_CAPACITY=20 令牌桶容量（允许的突发请求数）
# FAILURE_THRESHOLD=2    LLM 连续失败几次后走确定性兜底
